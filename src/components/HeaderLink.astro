---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const path = Astro.url.pathname;
const isActive = href === '/' ? path === '/' : path.startsWith(String(href));
---

<a href={href} aria-current={isActive ? 'page' : undefined} class:list={[className, { 'font-bold underline': isActive }]} {...props}>
	<slot />
</a>
