---
import { Image } from 'astro:assets';
import type { ReviewEntry, ShelfEntry } from '../lib/content';
import { entryUrl, stars } from '../lib/entries';

interface Props {
	item: ShelfEntry;
	review?: ReviewEntry;
}

const { item, review } = Astro.props;
const { data } = item;
const label = data.type === 'course' ? '강의' : '책';
---

<li class="border p-4">
	{
		review ? (
			<a href={entryUrl(review)}>
				<Image src={data.image} width={200} alt={data.title} />
				<p class="text-sm">{label}</p>
				<p class="font-semibold">{data.title}</p>
				<p>{stars(data.rating)}</p>
			</a>
		) : (
			<div>
				<Image src={data.image} width={200} alt={data.title} />
				<p class="text-sm">{label}</p>
				<p class="font-semibold">{data.title}</p>
				<p>{stars(data.rating)}</p>
			</div>
		)
	}
</li>
